---
import zachImage from '@/assets/Zach_Machacon_Headshot.png';
import Greeting from '@/components/Greeting.astro';
import { Image } from 'astro:assets';
---

<section
  id="hero"
  aria-label="Hero"
  class="h-screen overflow-hidden flex flex-col justify-between items-center image-gradient z-0"
>
  <div class="flex flex-col text-center gap-3 mt-36">
    <Greeting />
    <span class="text-lg sm:text-3xl md:text-4xl lg:text-5xl font-semibold w-full">
      I'm <span class="bg-hiyo-purple text-white px-3">Zach</span>. Bridging leadership, data, <br
      /> and the web for continuous growth.</span
    >
  </div>
  <div class="photo-glow">
    <Image
      src={zachImage}
      alt="Zach Riane Machacon"
      width={700}
      loading="eager"
      class="max-h-[65vh] w-auto object-contain object-bottom"
    />
  </div>
</section>

<style>
  .image-gradient {
    position: relative;
    background:
      radial-gradient(ellipse 50% 40% at 6% 6%, rgba(199, 190, 245, 0.55) 0%, transparent 70%),
      radial-gradient(ellipse 40% 32% at 94% 10%, rgba(199, 190, 245, 0.4) 0%, transparent 70%),
      radial-gradient(ellipse 65% 55% at 50% 102%, rgba(79, 16, 145, 0.13) 0%, transparent 62%),
      #edf3fe;
  }

  .image-gradient::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url(https://grainy-gradients.vercel.app/noise.svg);
    background-blend-mode: multiply;
    filter: contrast(150%) brightness(110%);
    pointer-events: none;
    z-index: 1;
  }

  .image-gradient > * {
    position: relative;
    z-index: 3;
  }

  .photo-glow {
    filter: drop-shadow(0 0 28px rgba(199, 190, 245, 0.9))
      drop-shadow(0 0 55px rgba(79, 16, 145, 0.18));
  }
</style>
