---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Experience } from '@/data/experiences';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif,svg}');

const logoPath = `/src/assets/${experience.companyLogo}`;

if (!images[logoPath]) {
  throw new Error(`"${logoPath}" does not exist in glob: "/src/assets/*.{jpeg,jpg,png,gif,svg}"`);
}

const isCurrent = experience.duration.includes('Present');
---

<div class="experience-card h-full">
  <div class="card-inner bg-white rounded-xl shadow-lg overflow-hidden h-full flex flex-col">
    <!-- Gradient accent bar -->
    <div class="h-1 w-full bg-gradient-to-r from-hiyo-purple to-purple-400"></div>

    <!-- Header -->
    <div class="flex items-start justify-between p-5 border-b border-gray-100">
      <div class="flex items-start gap-4">
        <!-- Logo -->
        <div
          class="logo-container rounded-lg bg-white shadow-sm border border-purple-100 w-14 h-14 flex items-center justify-center flex-shrink-0"
        >
          <Image
            src={images[logoPath]()}
            alt={`${experience.company} logo`}
            width={42}
            height={42}
            class="logo-image"
          />
        </div>

        <!-- Title + company + meta -->
        <div>
          <a href={experience.link} target="_blank" rel="noopener noreferrer">
            <h3 class="text-xl font-bold text-gray-800 hover-effect leading-tight">
              {experience.title}
            </h3>
          </a>
          <p class="text-sm font-semibold text-hiyo-purple mt-0.5">{experience.company}</p>
          <p class="text-xs text-gray-400 flex items-center mt-1 gap-1">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3 w-3 flex-shrink-0"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                clip-rule="evenodd"></path>
            </svg>
            {experience.location}
          </p>
          <p class="text-xs text-gray-400 flex items-center mt-1 gap-1">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3 w-3 flex-shrink-0"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"
                clip-rule="evenodd"></path>
            </svg>
            {experience.duration}
          </p>
        </div>
      </div>

      <!-- Current indicator -->
      {
        isCurrent && (
          <div class="flex items-center gap-1.5 flex-shrink-0 mt-1">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75" />
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500" />
            </span>
            <span class="text-xs font-semibold text-green-600">Current</span>
          </div>
        )
      }
    </div>

    <!-- Description -->
    <div class="p-5 flex-grow flex flex-col">
      <ul class="space-y-3 text-gray-600 text-sm flex-grow">
        {
          experience.description.map(item => (
            <li class="flex items-start list-item-hover gap-2">
              <span class="text-hiyo-purple font-bold mt-0.5 flex-shrink-0 select-none">–</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .card-inner {
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid rgba(229, 231, 235, 0.5);
    border-left: 3px solid transparent;
  }

  .card-inner:hover {
    transform: translateY(-8px);
    border-left-color: #4f1091;
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .hover-effect {
    position: relative;
    display: inline;
    background-image: linear-gradient(to right, #4f1091, #a855f7);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 2px;
    transition: background-size 0.3s ease;
    padding-bottom: 2px;
  }

  .experience-card:hover .hover-effect {
    background-size: 100% 2px;
  }

  .list-item-hover {
    transition: transform 0.2s ease;
  }

  .list-item-hover:hover {
    transform: translateX(3px);
  }

  .logo-container {
    padding: 6px;
  }

  .logo-image {
    width: 75%;
    height: 75%;
    max-width: 38px;
    max-height: 38px;
    object-fit: contain;
    display: block;
  }
</style>
